diff --git a/generator/templates/InputListTypes.xml b/generator/templates/InputListTypes.xml
new file mode 100644
index 0000000..b562736
--- /dev/null
+++ b/generator/templates/InputListTypes.xml
@@ -0,0 +1,27 @@
+@@# One port-selection ParameterType per board (<Name>$b.Slot): placeholder, the ports of the board
+@@# (value = hardware port number - 1, label = HW_INPUT_<n>_LABEL; the firmware maps value k to HW_INPUT_<k+1>,
+@@# also when <Inputs use> offers only some ports), optional extra entry (e.g. manual GPIO).
+@@# A board without ports gets EmptyText (PlaceholderValue) and EmptyFillerText (EmptyFillerValue).
+@@# Params: Name, PlaceholderText, PlaceholderValue, ExtraText, ExtraValue, EmptyText, EmptyFillerText,
+@@#         EmptyFillerValue, SizeInBit
+@@params Name! PlaceholderText! PlaceholderValue! ExtraText ExtraValue EmptyText EmptyFillerText EmptyFillerValue
+@@default SizeInBit = 8
+@@for $b in $Boards
+@@set $pt = $P.Name + $b.Slot
+<ParameterType Id="%AID%_PT-{{$pt}}" Name="{{$pt}}">
+  <TypeRestriction Base="Value" SizeInBit="{{$P.SizeInBit}}">
+@@if $b.Inputs.Count -eq 0
+    <Enumeration Text="{{Xml $P.EmptyText}}" Value="{{$P.PlaceholderValue}}" Id="%AID%_PT-{{$pt}}_EN-{{$P.PlaceholderValue}}" />
+    <Enumeration Text="{{Xml $P.EmptyFillerText}}" Value="{{$P.EmptyFillerValue}}" Id="%AID%_PT-{{$pt}}_EN-{{$P.EmptyFillerValue}}" />
+@@else
+    <Enumeration Text="{{Xml $P.PlaceholderText}}" Value="{{$P.PlaceholderValue}}" Id="%AID%_PT-{{$pt}}_EN-{{$P.PlaceholderValue}}" />
+@@for $port in $b.Inputs
+    <Enumeration Text="{{Xml $port.Label}}" Value="{{$port.N - 1}}" Id="%AID%_PT-{{$pt}}_EN-{{$port.N - 1}}" />
+@@end
+@@end
+@@if $P.ExtraText
+    <Enumeration Text="{{Xml $P.ExtraText}}" Value="{{$P.ExtraValue}}" Id="%AID%_PT-{{$pt}}_EN-{{$P.ExtraValue}}" />
+@@end
+  </TypeRestriction>
+</ParameterType>
+@@end
